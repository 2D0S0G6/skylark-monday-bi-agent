# ---------------------------------------------------------------------------
# Skylark Drones — Monday.com BI Agent
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# On Streamlit Community Cloud, put these same keys in App settings -> Secrets.
# ---------------------------------------------------------------------------

# --- required --------------------------------------------------------------
# Monday.com -> avatar -> Developers -> My access tokens
MONDAY_API_TOKEN=

# Board IDs: the number in the board URL, e.g. .../boards/1234567890
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# https://console.groq.com -> API Keys
GROQ_API_KEY=

# --- optional --------------------------------------------------------------
# Any Groq-hosted chat model. Run `python -m tools.list_models` to see valid IDs.
# Groq retires models periodically. Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Seconds to reuse a Monday.com snapshot before refetching. Default: 300
CACHE_TTL_SECONDS=300

# Fiscal year start month. 4 = Indian FY (Apr-Mar), 1 = calendar year. Default: 4
FISCAL_YEAR_START_MONTH=4

# Items requested per Monday.com page. Default: 250 (max 500)
MONDAY_PAGE_SIZE=250

# HTTP timeout in seconds for Monday.com calls. Default: 45
REQUEST_TIMEOUT_SECONDS=45

# Days past the planned end date before a work order counts as delayed. Default: 0
DELAY_GRACE_DAYS=0

# Monday.com GraphQL endpoint / API version (change only if Monday changes them)
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2024-10

# DEBUG | INFO | WARNING | ERROR. Default: INFO
LOG_LEVEL=INFO
